# VAARL Web Backend environment variables
# Copy this file to your deployment environment settings. Do not commit real secrets.

VAARL_API_PORT=8080
VAARL_DB_URL=jdbc:postgresql://localhost:5432/vaarl_db
VAARL_DB_USER=your_database_user
VAARL_DB_PASSWORD=your_database_password
VAARL_JWT_SECRET=replace_with_a_long_random_secret

# SMTP provider settings (example values; use your provider's SMTP details)
VAARL_SMTP_HOST=smtp.example.com
VAARL_SMTP_PORT=587
VAARL_SMTP_USER=your_sender_email@example.com
VAARL_SMTP_PASSWORD=your_smtp_app_password
VAARL_SMTP_AUTH=true
VAARL_SMTP_STARTTLS=true

# Public frontend URLs used in email links
VAARL_EMAIL_VERIFICATION_URL=https://your-site.example/verify-email
VAARL_PASSWORD_RESET_URL=https://your-site.example/reset-password
