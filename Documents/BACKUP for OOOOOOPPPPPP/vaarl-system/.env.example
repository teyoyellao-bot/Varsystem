# Copy these values into your OS environment variables (or your IDE run configuration).
VAARL_DB_URL=jdbc:postgresql://localhost:5432/vaarl_db
VAARL_DB_USER=your_postgres_user
VAARL_DB_PASSWORD=your_postgres_password

# Optional - only needed for the "Forgot password" OTP email
VAARL_SMTP_EMAIL=your_gmail_address
VAARL_SMTP_APP_PASSWORD=your_gmail_app_password
# VAARL_SMTP_HOST=smtp.gmail.com
# VAARL_SMTP_PORT=465
